# Object files (Intermediate compiled files)
# Ignores standard compiled object files generated from the .c files
*.o 
# Ignores static library archives
*.a
# Ignores shared/dynamic libraries
*.so

# Binaries (Assuming 'kvstore' will be the executable name)
# Ignores the main compiled program
kvstore
# Ignores the special memory-testing version of the program
kvstore_asan

# VS Code / Language Server
# Ignores the specific VS Code workspace settings
.vscode/
# Ignores temporary cache files
.cache/
# Ignores the auto-generated file clangd uses for code completion
compile_commands.json

# Core Dumps (Crash reports)
# Ignores memory dumps created if the program crashes (segfaults)
core
# Ignores core dumps that might have a process ID appended to the name
core.*

# Valgrind/ASan logs (Debugging output)
# Ignores crash dumps specifically generated by the Valgrind tool
vgcore.*
# Ignores any general log files the program or debuggers might output
*.log

docs/diary.md 
